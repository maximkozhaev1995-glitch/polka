      "owner": "postgres",
      "signature": "is_staff()",
      "definition": "CREATE OR REPLACE FUNCTION public.is_staff()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n select exists(select 1 from public.users where tg_id=public.me_tg() and venue_id is not null)\n$function$\n"
